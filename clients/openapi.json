{
  "openapi": "3.1.0",
  "info": {
    "title": "SaveSpace API",
    "description": "Design doc §11. Paths are relative to /v1.",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "paths": {
    "/accounts": {
      "get": {
        "tags": [
          "connections"
        ],
        "summary": "Lists accounts with their latest balances.",
        "operationId": "list_accounts",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountList"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login/finish": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Finishes passkey sign-in. Sets the session cookie.",
        "operationId": "login_finish",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssertionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {},
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login/start": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Starts passkey sign-in.",
        "operationId": "login_start",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs out. Works without a valid session, so a stale cookie is removed.",
        "operationId": "logout",
        "responses": {
          "204": {}
        }
      }
    },
    "/auth/recover": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs in with a recovery code. The code works once. The new session can\nadd a passkey right away.",
        "operationId": "recover",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoverRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {},
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/auth/setup": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Reports whether owner setup can start.",
        "operationId": "setup_status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        }
      }
    },
    "/auth/setup/finish": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Finishes owner setup. Signs the owner in and returns recovery codes.",
        "operationId": "setup_finish",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupFinishRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryCodes"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/auth/setup/start": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Starts owner setup. Checks the setup code and returns passkey options.",
        "operationId": "setup_start",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupStartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify/finish": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Finishes a step-up check.",
        "operationId": "verify_finish",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssertionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StepUp"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify/start": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Starts a passkey check for step-up actions.",
        "operationId": "verify_start",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/connections": {
      "get": {
        "tags": [
          "connections"
        ],
        "summary": "Lists bank connections and their health.",
        "operationId": "list_connections",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionList"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "connections"
        ],
        "summary": "Connects accounts: exchanges the public token and starts the first sync.",
        "operationId": "create_connection",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConnectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/connections/{id}": {
      "delete": {
        "tags": [
          "connections"
        ],
        "summary": "Removes a connection at the bank and deletes its accounts and\ntransactions. Needs step-up.",
        "operationId": "delete_connection",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The connection ID (`conn_…`).",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {},
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/connections/{id}/sync": {
      "post": {
        "tags": [
          "connections"
        ],
        "summary": "Starts a sync now.",
        "operationId": "sync_connection",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The connection ID (`conn_…`).",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {},
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/link_tokens": {
      "post": {
        "tags": [
          "connections"
        ],
        "summary": "Creates a Plaid Link token. Needs step-up (§12.1: a new connection).",
        "operationId": "create_link_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkToken"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Gets the signed-in person.",
        "operationId": "get_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/me/passkeys/finish": {
      "post": {
        "tags": [
          "me"
        ],
        "summary": "Finishes adding a passkey. Needs step-up.",
        "operationId": "add_passkey_finish",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddPasskeyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasskeyCreated"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/me/passkeys/start": {
      "post": {
        "tags": [
          "me"
        ],
        "summary": "Starts adding a passkey. Needs step-up.",
        "operationId": "add_passkey_start",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Challenge"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/me/passkeys/{id}": {
      "delete": {
        "tags": [
          "me"
        ],
        "summary": "Deletes a passkey. The last passkey cannot be deleted. Needs step-up.",
        "operationId": "delete_passkey",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The passkey ID (`pk_…`).",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {},
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/me/recovery_codes": {
      "post": {
        "tags": [
          "me"
        ],
        "summary": "Replaces the recovery codes with a new set. Needs step-up.",
        "operationId": "regenerate_recovery_codes",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryCodes"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/transactions": {
      "get": {
        "tags": [
          "connections"
        ],
        "summary": "Lists transactions, newest first. M3 adds filters and search.",
        "operationId": "list_transactions",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "1 to 100. The default is 50.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "starting_after",
            "in": "query",
            "description": "The last transaction ID (`txn_…`) of the previous page.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionList"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/plaid": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Receives a Plaid webhook. Plaid signs it with the `Plaid-Verification`\nheader (ES256 JWT).",
        "operationId": "plaid_webhook",
        "requestBody": {
          "description": "The Plaid webhook body.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {},
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Account": {
        "type": "object",
        "description": "A bank or card account.",
        "required": [
          "id",
          "connection_id",
          "name",
          "type",
          "currency"
        ],
        "properties": {
          "available_minor": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The available balance in minor units."
          },
          "balance_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the balances were read (RFC 3339)."
          },
          "connection_id": {
            "type": "string",
            "description": "The connection ID (`conn_…`)."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 code."
          },
          "current_minor": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The current balance in minor units."
          },
          "id": {
            "type": "string",
            "description": "The account ID (`acct_…`)."
          },
          "limit_minor": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The credit limit in minor units."
          },
          "mask": {
            "type": [
              "string",
              "null"
            ],
            "description": "The last digits of the account number."
          },
          "name": {
            "type": "string",
            "description": "The account name."
          },
          "official_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The official name."
          },
          "subtype": {
            "type": [
              "string",
              "null"
            ],
            "description": "For example `checking`, `savings`, `credit card`."
          },
          "type": {
            "type": "string",
            "description": "For example `depository`, `credit`, `loan`."
          }
        }
      },
      "AccountList": {
        "type": "object",
        "description": "A list of accounts.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            },
            "description": "The accounts."
          }
        }
      },
      "AddPasskeyRequest": {
        "type": "object",
        "description": "Finish adding a passkey.",
        "required": [
          "challenge_id",
          "credential",
          "name"
        ],
        "properties": {
          "challenge_id": {
            "type": "string",
            "description": "The ID from the start response."
          },
          "credential": {
            "type": "object",
            "description": "The result of `navigator.credentials.create()`, in JSON form."
          },
          "name": {
            "type": "string",
            "description": "A name for this passkey. 1 to 100 characters."
          }
        }
      },
      "ApiError": {
        "type": "object",
        "description": "An API error.",
        "required": [
          "type",
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "A stable, machine-readable code, for example `step_up_required`."
          },
          "message": {
            "type": "string",
            "description": "A sentence for a developer. The web app shows its own text."
          },
          "param": {
            "type": [
              "string",
              "null"
            ],
            "description": "The request field that caused the error, if any."
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The request ID, the same as the `Request-Id` header."
          },
          "type": {
            "$ref": "#/components/schemas/ErrorType",
            "description": "The error class."
          }
        }
      },
      "AssertionRequest": {
        "type": "object",
        "description": "Finish a passkey check.",
        "required": [
          "challenge_id",
          "credential"
        ],
        "properties": {
          "challenge_id": {
            "type": "string",
            "description": "The ID from the start response."
          },
          "credential": {
            "type": "object",
            "description": "The result of `navigator.credentials.get()`, in JSON form."
          }
        }
      },
      "Challenge": {
        "type": "object",
        "description": "A WebAuthn challenge.",
        "required": [
          "challenge_id",
          "options"
        ],
        "properties": {
          "challenge_id": {
            "type": "string",
            "description": "Send this ID back with the authenticator response. Valid for 5 minutes."
          },
          "options": {
            "type": "object",
            "description": "Options for `navigator.credentials.create()` or `.get()`, in the\nWebAuthn JSON form (binary fields are base64url)."
          }
        }
      },
      "Connection": {
        "type": "object",
        "description": "A bank connection.",
        "required": [
          "id",
          "status",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it was connected (RFC 3339)."
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "The provider error code of the last failure."
          },
          "id": {
            "type": "string",
            "description": "The connection ID (`conn_…`)."
          },
          "institution_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The institution name."
          },
          "last_synced_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The last successful sync (RFC 3339)."
          },
          "status": {
            "type": "string",
            "description": "`syncing`, `ok`, `login_required`, `pending_expiration`, `revoked`, or `error`."
          }
        }
      },
      "ConnectionList": {
        "type": "object",
        "description": "A list of connections.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Connection"
            },
            "description": "The connections, oldest first."
          }
        }
      },
      "CreateConnectionRequest": {
        "type": "object",
        "description": "Connect accounts with the result of Plaid Link.",
        "required": [
          "public_token"
        ],
        "properties": {
          "institution": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Institution",
                "description": "The institution from the Link metadata, for display."
              },
              {
                "type": "null"
              }
            ]
          },
          "public_token": {
            "type": "string",
            "description": "The `public_token` from Plaid Link `onSuccess`."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The JSON body of every error response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError",
            "description": "The error."
          }
        }
      },
      "ErrorType": {
        "type": "string",
        "description": "The error `type` values from §11.4.",
        "enum": [
          "invalid_request_error",
          "authentication_error",
          "permission_error",
          "not_found_error",
          "rate_limit_error",
          "api_error"
        ]
      },
      "Institution": {
        "type": "object",
        "description": "An institution.",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The provider's institution ID."
          },
          "name": {
            "type": "string",
            "description": "The institution name."
          }
        }
      },
      "LinkToken": {
        "type": "object",
        "description": "A link token for Plaid Link.",
        "required": [
          "link_token"
        ],
        "properties": {
          "expiration": {
            "type": [
              "string",
              "null"
            ],
            "description": "When it expires (RFC 3339)."
          },
          "link_token": {
            "type": "string",
            "description": "Pass to `Plaid.create({ token })`."
          }
        }
      },
      "LinkTokenRequest": {
        "type": "object",
        "description": "Create a link token.",
        "properties": {
          "connection_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set to repair an existing connection (update mode)."
          }
        }
      },
      "Me": {
        "type": "object",
        "description": "The signed-in person.",
        "required": [
          "id",
          "household_id",
          "display_name",
          "time_zone",
          "calm_mode",
          "step_up_until",
          "passkeys",
          "recovery_codes_left"
        ],
        "properties": {
          "calm_mode": {
            "type": "boolean",
            "description": "Calm mode: hide exact balances until the person taps."
          },
          "display_name": {
            "type": "string",
            "description": "The display name."
          },
          "household_id": {
            "type": "string",
            "description": "The household ID (`hh_…`)."
          },
          "id": {
            "type": "string",
            "description": "The user ID (`usr_…`)."
          },
          "passkeys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Passkey"
            },
            "description": "Registered passkeys."
          },
          "recovery_codes_left": {
            "type": "integer",
            "format": "int64",
            "description": "Unused recovery codes."
          },
          "step_up_until": {
            "type": "string",
            "format": "date-time",
            "description": "Step-up actions are allowed until this time (RFC 3339). A time in the\npast means the person must confirm with a passkey first."
          },
          "time_zone": {
            "type": "string",
            "description": "The IANA time zone, for example `America/New_York`."
          }
        }
      },
      "Passkey": {
        "type": "object",
        "description": "A registered passkey.",
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it was added (RFC 3339)."
          },
          "id": {
            "type": "string",
            "description": "The passkey ID (`pk_…`)."
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The last use (RFC 3339), if any."
          },
          "name": {
            "type": "string",
            "description": "The name the person gave it."
          }
        }
      },
      "PasskeyCreated": {
        "type": "object",
        "description": "A new passkey.",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The passkey ID (`pk_…`)."
          }
        }
      },
      "RecoverRequest": {
        "type": "object",
        "description": "Sign in with a recovery code.",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "A recovery code. Case, spaces, and dashes do not matter."
          }
        }
      },
      "RecoveryCodes": {
        "type": "object",
        "description": "Recovery codes. Shown once. Each code works one time.",
        "required": [
          "recovery_codes"
        ],
        "properties": {
          "recovery_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ten codes in the form `XXXX-XXXX-XXXX`."
          }
        }
      },
      "SetupFinishRequest": {
        "type": "object",
        "description": "Finish owner setup.",
        "required": [
          "challenge_id",
          "credential",
          "passkey_name"
        ],
        "properties": {
          "challenge_id": {
            "type": "string",
            "description": "The ID from the start response."
          },
          "credential": {
            "type": "object",
            "description": "The result of `navigator.credentials.create()`, in JSON form."
          },
          "passkey_name": {
            "type": "string",
            "description": "A name for this passkey, for example \"Laptop\". 1 to 100 characters."
          }
        }
      },
      "SetupStartRequest": {
        "type": "object",
        "description": "Start owner setup.",
        "required": [
          "setup_code",
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "description": "The name to show in the app. 1 to 100 characters."
          },
          "setup_code": {
            "type": "string",
            "description": "The one-time setup code from Secret Manager (`owner-setup-code`)."
          }
        }
      },
      "SetupStatus": {
        "type": "object",
        "description": "Whether owner setup can start.",
        "required": [
          "setup_open"
        ],
        "properties": {
          "setup_open": {
            "type": "boolean",
            "description": "True if the server has a setup code and no owner exists yet."
          }
        }
      },
      "StepUp": {
        "type": "object",
        "description": "The result of a step-up check.",
        "required": [
          "step_up_until"
        ],
        "properties": {
          "step_up_until": {
            "type": "string",
            "format": "date-time",
            "description": "Step-up actions are allowed until this time (RFC 3339)."
          }
        }
      },
      "Transaction": {
        "type": "object",
        "description": "A transaction.",
        "required": [
          "id",
          "account_id",
          "amount_minor",
          "currency",
          "date",
          "name",
          "pending"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "description": "The account ID (`acct_…`)."
          },
          "amount_minor": {
            "type": "integer",
            "format": "int64",
            "description": "The amount in minor units. Negative is money out."
          },
          "category_primary": {
            "type": [
              "string",
              "null"
            ],
            "description": "The provider's broad category."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 code."
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "The bank date (`YYYY-MM-DD`)."
          },
          "id": {
            "type": "string",
            "description": "The transaction ID (`txn_…`)."
          },
          "merchant_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The merchant, if known."
          },
          "name": {
            "type": "string",
            "description": "The description."
          },
          "pending": {
            "type": "boolean",
            "description": "True while pending."
          }
        }
      },
      "TransactionList": {
        "type": "object",
        "description": "A page of transactions (§11.5).",
        "required": [
          "data",
          "has_more"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            },
            "description": "Newest first."
          },
          "has_more": {
            "type": "boolean",
            "description": "True if more transactions follow. Pass the last ID as `starting_after`."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "Owner setup, passkey sign-in, and step-up checks."
    },
    {
      "name": "me",
      "description": "The signed-in person."
    },
    {
      "name": "connections",
      "description": "Bank connections, accounts, and transactions."
    },
    {
      "name": "webhooks",
      "description": "Signed webhooks from providers."
    }
  ]
}

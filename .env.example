# Copy to .env for local development. .env is git-ignored.
# Matches compose.yaml. Development credentials only.
DATABASE_URL=postgres://savespace:savespace@127.0.0.1:5432/savespace

SAVESPACE_API_ADDR=127.0.0.1:8080
# gcp, json, or pretty
SAVESPACE_LOG_FORMAT=pretty
RUST_LOG=info

# Plaid. Get sandbox keys at dashboard.plaid.com. Never commit real values.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=

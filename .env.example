# Copy to .env for local development. .env is git-ignored.
# Matches compose.yaml. Development credentials only.
DATABASE_URL=postgres://savespace:savespace@127.0.0.1:5432/savespace

SAVESPACE_API_ADDR=127.0.0.1:8080
# The URL you open in the browser. Passkeys are bound to its host name.
# Use http://localhost:5173 with the Vite dev server.
SAVESPACE_PUBLIC_ORIGIN=http://localhost:8080
# One-time owner setup code. Any value works locally.
SAVESPACE_OWNER_SETUP_CODE=local-setup-code
# gcp, json, or pretty
SAVESPACE_LOG_FORMAT=pretty
RUST_LOG=info

# Plaid. Get sandbox keys at dashboard.plaid.com. Never commit real values.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Key-encryption key for Plaid access tokens: 32 random bytes, base64.
# Make one with: openssl rand -base64 32
SAVESPACE_TOKEN_KEK=
